<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_one_ui_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- One UI 8 Header: Category & Quick Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_follicular" />

        <TextView
            android:id="@+id/widget_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="@string/widget_header_category"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- One UI 8 Quick Log Circular Action Button -->
        <ImageButton
            android:id="@+id/widget_btn_quick_log"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_circle_btn_bg"
            android:contentDescription="@string/widget_action_log"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hero Cycle Day (One UI 8 Bold Typography) -->
    <TextView
        android:id="@+id/widget_cycle_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="Day 1"
        android:textColor="@color/widget_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- One UI 8 Soft Phase Pill Capsule -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/widget_phase_pill_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_follicular" />

        <TextView
            android:id="@+id/widget_phase_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Follicular Phase"
            android:textColor="@color/widget_phase_follicular_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Footer Milestone / Cycle Timing Info -->
    <TextView
        android:id="@+id/widget_milestone_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Next period in 14 days"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
