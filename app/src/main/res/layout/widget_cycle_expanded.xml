<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_one_ui_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left Column: Glance Metrics -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <!-- Category & Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_follicular" />

            <TextView
                android:id="@+id/widget_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/widget_header_category"
                android:textAllCaps="true"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hero Cycle Day (One UI 8 Large Display Typography) -->
        <TextView
            android:id="@+id/widget_cycle_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Day 1"
            android:textColor="@color/widget_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- One UI 8 Soft Phase Pill Capsule -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/widget_phase_pill_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill_follicular" />

            <TextView
                android:id="@+id/widget_phase_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="3.5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3.5dp"
                android:text="Follicular Phase"
                android:textColor="@color/widget_phase_follicular_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Milestone Status -->
        <TextView
            android:id="@+id/widget_milestone_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Next period in 14 days"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Vertical Divider (Subtle One UI line) -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- Right Column: Cycle Progress & Quick Action -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Progress Header -->
        <TextView
            android:id="@+id/widget_progress_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cycle progress · 50%"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- One UI Rounded Horizontal Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- Daily Logging Status -->
        <TextView
            android:id="@+id/widget_log_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Logged today: Medium flow"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <!-- One UI 8 Capsule Action Button -->
        <TextView
            android:id="@+id/widget_btn_quick_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="@string/widget_action_log_today"
            android:textColor="@color/widget_action_btn_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
